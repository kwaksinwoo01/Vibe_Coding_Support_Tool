{
  "version": "1.0.0",
  "description": "Default decision policies for 6-tier orchestration system",
  "rules": [
    {
      "name": "low_confidence_human_approval",
      "description": "Require human approval for low confidence routing decisions",
      "condition": {
        "field": "confidence",
        "operator": "<",
        "value": 0.4
      },
      "action": {
        "requires_human_approval": true,
        "metadata": {
          "reason": "Confidence below threshold",
          "threshold": 0.4
        }
      },
      "priority": 100,
      "enabled": true
    },
    {
      "name": "cost_limit_fallback",
      "description": "Use alternative tier when estimated cost exceeds budget",
      "condition": {
        "field": "estimated_cost",
        "operator": ">",
        "value": 100.0
      },
      "action": {
        "use_alternative": true,
        "alternative_tier": "E",
        "metadata": {
          "reason": "Cost exceeds budget",
          "cost_limit": 100.0
        }
      },
      "priority": 90,
      "enabled": true
    },
    {
      "name": "max_retries_issue_analysis",
      "description": "Route to issue analysis tier after maximum retries reached",
      "condition": {
        "field": "retry_count",
        "operator": ">=",
        "value": 3
      },
      "action": {
        "use_alternative": true,
        "alternative_tier": "D",
        "metadata": {
          "reason": "Max retries reached",
          "max_retries": 3
        }
      },
      "priority": 95,
      "enabled": true
    },
    {
      "name": "failure_to_issue_analysis",
      "description": "Route failed executions to issue analysis tier",
      "condition": {
        "field": "status",
        "operator": "==",
        "value": "FAILED"
      },
      "action": {
        "use_alternative": true,
        "alternative_tier": "D",
        "metadata": {
          "reason": "Execution failed"
        }
      },
      "priority": 85,
      "enabled": true
    },
    {
      "name": "partial_success_enhancement",
      "description": "Route partial successes to document management for completion",
      "condition": {
        "field": "status",
        "operator": "==",
        "value": "PARTIAL"
      },
      "action": {
        "use_alternative": true,
        "alternative_tier": "E",
        "metadata": {
          "reason": "Partial success - complete in document management"
        }
      },
      "priority": 75,
      "enabled": true
    },
    {
      "name": "high_confidence_fast_track",
      "description": "Fast track high confidence routing decisions",
      "condition": {
        "field": "confidence",
        "operator": ">=",
        "value": 0.9
      },
      "action": {
        "override_confidence": 0.95,
        "metadata": {
          "reason": "High confidence - fast track",
          "confidence_threshold": 0.9
        }
      },
      "priority": 80,
      "enabled": true
    },
    {
      "name": "slow_execution_warning",
      "description": "Flag slow executions for performance review",
      "condition": {
        "field": "execution_time_ms",
        "operator": ">",
        "value": 10000
      },
      "action": {
        "metadata": {
          "reason": "Slow execution detected",
          "threshold_ms": 10000,
          "flag": "performance_review_needed"
        }
      },
      "priority": 60,
      "enabled": true
    },
    {
      "name": "tier_a_to_b_chain",
      "description": "Auto-chain successful Tier A to Tier B",
      "condition": {
        "field": "tier",
        "operator": "==",
        "value": "A"
      },
      "action": {
        "use_alternative": true,
        "alternative_tier": "B",
        "metadata": {
          "reason": "Standard A→B workflow chain"
        }
      },
      "priority": 50,
      "enabled": true
    },
    {
      "name": "tier_b_to_e_chain",
      "description": "Auto-chain successful Tier B to Tier E",
      "condition": {
        "field": "tier",
        "operator": "==",
        "value": "B"
      },
      "action": {
        "use_alternative": true,
        "alternative_tier": "E",
        "metadata": {
          "reason": "Standard B→E workflow chain"
        }
      },
      "priority": 50,
      "enabled": true
    },
    {
      "name": "tier_c_to_e_chain",
      "description": "Auto-chain successful Tier C to Tier E",
      "condition": {
        "field": "tier",
        "operator": "==",
        "value": "C"
      },
      "action": {
        "use_alternative": true,
        "alternative_tier": "E",
        "metadata": {
          "reason": "Standard C→E workflow chain"
        }
      },
      "priority": 50,
      "enabled": true
    }
  ]
}
